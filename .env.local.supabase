# ===========================================
# SUPABASE HOSTING CONFIGURATION
# ===========================================
# Copy this to .env.local when using Supabase

# ===========================================
# HOSTING MODE
# ===========================================
HOSTING_MODE=supabase

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ===========================================
# DATABASE CONFIGURATION (PostgreSQL via Supabase)
# ===========================================
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_ID].supabase.co:5432/postgres"

# ===========================================
# AUTHENTICATION (Supabase Auth)
# ===========================================
NEXTAUTH_URL=https://your-vercel-app.vercel.app
NEXTAUTH_SECRET=super-secret-nextauth-key-change-this-in-production-min-32-chars

# ===========================================
# EMAIL CONFIGURATION (Supabase SMTP)
# ===========================================
# Supabase handles email automatically, but you can override:
SMTP_HOST=smtp.supabase.co
SMTP_PORT=587
SMTP_USER=your-supabase-smtp-user
SMTP_PASSWORD=your-supabase-smtp-password
SMTP_FROM="Open Source Project Manager <noreply@yourdomain.com>"
SMTP_SECURE=true

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=production
APP_URL=https://your-vercel-app.vercel.app
APP_NAME="Open Source Project Manager"
API_SECRET_KEY=your-api-secret-key-here-min-32-characters

# ===========================================
# FILE STORAGE (Supabase Storage)
# ===========================================
SUPABASE_STORAGE_BUCKET=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,txt,md
STORAGE_TYPE=supabase

# ===========================================
# SECURITY SETTINGS
# ===========================================
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key-min-32-characters-long
CORS_ORIGIN=https://your-vercel-app.vercel.app

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900000

# ===========================================
# OAUTH PROVIDERS (via Supabase)
# ===========================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===========================================
# EXTERNAL INTEGRATIONS
# ===========================================
GITHUB_TOKEN=your_github_personal_access_token

# ===========================================
# ADMIN CONFIGURATION
# ===========================================
ADMIN_EMAIL=admin@yourdomain.com

# ===========================================
# SUPABASE SPECIFIC SETTINGS
# ===========================================
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_DB_PASSWORD=your-supabase-db-password
